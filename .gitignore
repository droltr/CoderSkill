# Machine-local project context and repository registry
.coderskill/local/
.coderskill/*.local.*

# Credentials, environment files, and diagnostics
.env
.env.*
*.pem
*.key
diagnostics/
artifacts/

# Common local caches
.venv/
node_modules/
__pycache__/
.pytest_cache/

# Local agent session data (also ignored by its own .gitignore)
.agent-sessions/

# Local-only private work files (research, plans, requests, sessions, notes)
.private/
